---
import "../styles/global.css";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  headerSize?: "site" | "large";
  /**
   * "light" (default) keeps the light page background used across the site.
   * "dark" sets a dark page background and switches the header to its dark
   * variant. Used by /about (full dark-page design, Figma 68:109).
   */
  theme?: "light" | "dark";
  /**
   * Optional schema.org JSON-LD object (e.g. Person, CreativeWork) for this
   * page. Rendered as a single <script type="application/ld+json"> tag.
   * Added July 14 2026 as part of the SEO pass — used on / and /about.
   */
  jsonLd?: Record<string, unknown>;
  /**
   * Social share image (og:image / twitter:image) for this page — a
   * root-relative path (e.g. "/images/cmb-portrait-colour.jpg"), resolved
   * against Astro.site the same way canonicalURL is. Added July 21 2026
   * (pre-launch SEO pass): BaseLayout previously had no og:image at all,
   * so every shared link (Instagram, LinkedIn, iMessage, etc.) rendered
   * with no preview image. Defaults to Cathal's own portrait so every
   * page has SOME image even without an override; pages with a more
   * relevant shot (e.g. the photography pages, using their own cover
   * photos) should pass one in.
   */
  image?: string;
}

const {
  title = "Cathal Mac an Bheatha — Digital Creator & Brand Strategist",
  description = "I help Irish brands stand out and scale. Brand strategy, UX/UI and product design, photography and videography for business clients.",
  headerSize = "large",
  theme = "light",
  jsonLd,
  image = "/images/cmb-portrait-colour.jpg",
} = Astro.props;

const dark = theme === "dark";

// Canonical URL for this exact page — also used for og:url, which was
// previously hardcoded to Astro.site (i.e. the same URL on every page).
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Google Analytics 4 — ported from the legacy 11ty site (_legacy/src/_includes
// /layouts/base.njk + case-study.njk), which had this on every page but it
// never got carried over during the Astro rebuild, so the live site had zero
// analytics until this was re-added (July 15 2026). Same property/ID as
// before, just centralised here in BaseLayout instead of duplicated per
// layout, since every page already routes through this one file.
const GA_MEASUREMENT_ID = "G-JXNZD09HPE";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", GA_MEASUREMENT_ID);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Preload the primary typeface once the file is added to /public/fonts -->
    <link
      rel="preload"
      href="/fonts/PPNeueMontreal-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class:list={[dark && "bg-n900"]}>
    <Header size={headerSize} theme={theme} />
    <slot />
    <Footer />
  </body>
</html>
