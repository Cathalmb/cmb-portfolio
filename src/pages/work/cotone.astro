---
/**
 * Cotone — brand/design template. Content ported from
 * _legacy/src/work/cotone.njk verbatim. One signature section ("The
 * Website") between "What I Delivered" and "Outcomes".
 *
 * FLAG: legacy frontmatter's nextProject.previewImage pointed to
 * /images/work/three-ireland/hero.jpg — that file doesn't exist (the real
 * asset is hero.webp, confirmed when Three Ireland's own page was built).
 * Corrected to hero.webp here rather than porting a broken link.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/primitives/Container.astro";
import CaseStudyHero from "../../components/sections/CaseStudyHero.astro";
import CaseStudySectionIntro from "../../components/sections/CaseStudySectionIntro.astro";
import CaseStudyImageGrid from "../../components/sections/CaseStudyImageGrid.astro";
import CaseStudyPillarGrid from "../../components/sections/CaseStudyPillarGrid.astro";
import CaseStudyFullImage from "../../components/sections/CaseStudyFullImage.astro";
