---
/**
 * /work/photography/concerts — the second collection page, mirrors
 * portraits.astro exactly (same layout/scaffold, different collection
 * key). Images auto-discovered from
 * public/images/work/photography/concerts/ (see src/lib/photography.ts).
 *
 * PINNED FRONT + AUTO-BALANCED REST (Cathal, July 21 2026): same
 * mechanism as portraits.astro — see that file's longer note. No
 * groupSize; the whole collection flows through one continuous height-
 * balanced masonry. CONCERTS_ORDER below is transcribed from a live
 * fetch of portfolio.cathalmb.com/concerts (40 filenames, everything
 * that page rendered) and now acts as a priority list, not a strict
 * pairing/position list — applyOrder() still puts these first, in this
 * order, but PhotoMasonry no longer forces any specific column pairing.
 * Anything in the local folder not in this list — currently ~50 files —
 * is appended afterward via applyOrder(), in normal natural-filename-
 * sort order.
 *
 * One entry, "25-04-2023_Gig-Do-Ronan_Whelans_161.jpg", didn't match any
 * file in this folder when checked against the real archive — it's kept
 * in the list (applyOrder silently skips unmatched filenames, same as
 * OVERVIEW_ORDER) rather than guessed at. The closest local filename is
 * "..._Whelans_162.jpg" — worth a quick check from Cathal in case it's
 * the same shot renamed, but not assumed here.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/primitives/Container.astro";
import PhotoMasonry from "../../../components/sections/PhotoMasonry.astro";
import PhotographyCta from "../../../components/sections/PhotographyCta.astro";
import { getPhotoCollection, applyOrder } from "../../../lib/photography";

const CONCERTS_ORDER = [
  "10-06-22_FeileNaGealai_La-2_400.jpg",
  "Cathal-Mac-an-Bheatha_saint-sister_01.jpg",
  "EP2023_The-Last-Dinner-Party_001-Social.jpg",
  "_DSF0532.jpg",
  "10-06-22_FeileNaGealai_La-2_295.jpg",
  "10-06-22_FeileNaGealai_La-2_366.jpg",
  "27-07-2024_Huartan_Feile-na-Gealai_105.jpg",
  "_DSF0435.jpg",
  "Feile-na-Gealai_2024_102.jpg",
  "10-06-22_FeileNaGealai_La-1_20.jpg",
  "Barrestown25-28092019-48.jpg",
  "EP23_Hannah-Grae-001.jpg",
  "CMB-LEH-Comp-01.jpg",
  "27-07-2024_Huartan_Feile-na-Gealai_107.jpg",
  "EP2023_The-Last-Dinner-Party_002-Social.jpg",
  "Murder-Capital-Electric-Picnice_2023-Social.jpg",
  "27-01-2023_TradFest_Blath-na-hOige_04.jpg",
  "10-06-22_FeileNaGealai_La-2_310.jpg",
  "Anna-From-the-North-social.jpg",
  "25-04-2023_Gig-Do-Ronan_Whelans_052.jpg",
  "_DSF3833.jpg",
  "Murder-Capital-Electric-Picnice_2023-Social_002.jpg",
  "27-01-2023_TradFest_Blath-na-hOige_09.jpg",
  "Cathal-Mac-an-Bheatha_Grad-Nos_03.jpg",
  "EP2023_The-Last-Dinner-Party_003-Social.jpg",
  "14062019-Feile_na_Gealai_2019-Sathairn.jpg",
  "_DSF1944.jpg",
  "Cathal-Mac-an-Bheatha_FNG_02.jpg",
  "10-06-22_FeileNaGealai_La-2_403.jpg",
  "15-10-21_LEH_The-Sound-House_139.jpg",
  "Cathal-Mac-an-Bheatha_DQF_01.jpg",
  "25-04-2023_Gig-Do-Ronan_Whelans_161.jpg",
  "Cathal-Mac-an-Bheatha_FNG_05.jpg",
