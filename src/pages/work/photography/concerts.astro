const items = applyOrder(getPhotoCollection("concerts"), CONCERTS_ORDER);

const title = "Concerts & Live | Photography | Cathal Mac an Bheatha";
// Description lengthened toward the 150–160 char range with a soft CTA
// (pre-launch SEO pass, July 21 2026) — was ~126 chars, under the usual
// SERP snippet allowance.
const description =
  "Concert and festival photography by Cathal Mac an Bheatha — Electric Picnic, Féile na Gealaí and live music shot from the pit. Get in touch to book a shoot.";
// Same pinned cover file PhotographyChooser.astro uses for this collection.
const image = "/images/work/photography/concerts/10-06-22_FeileNaGealai_La-2_403.jpg";
---

<BaseLayout title={title} description={description} image={image}>
  <section class="bg-n100">
    <Container size="large">
      <div class="border-t border-n200 pt-2 pb-8 lg:pb-12">
        <a href="/work/photography" class="text-body-md text-n500 transition-colors hover:text-n900">← Photography</a>
        <h1 data-reveal class="mt-6 max-w-[1004px] text-heading-xl text-n900 lg:mt-8 lg:text-display-lg">
          Concerts &amp; live<span class="text-ochre">.</span>
        </h1>
      </div>
    </Container>
  </section>

  <section class="bg-n100 pb-16 lg:pb-[192px]">
    {
      items.length > 0 ? (
        <PhotoMasonry
          items={items}
          altFallback="Concert and festival photography by Cathal Mac an Bheatha"
        />
      ) : (
        <Container size="large">
          <p class="text-body-md text-n500">Gallery coming soon.</p>
        </Container>
      )
    }
  </section>

  <PhotographyCta
    heading="Reach out, and let's shoot"
    body="Whether it's for an event or a concert or just to say hello, I'd love to hear from you!"
  />
</BaseLayout>

<script>
  const root = document.documentElement;
  const els = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (els.length) {
    root.classList.add("reveal-ready");
    if (reduce || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-revealed"));
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      els.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const alreadyInView = rect.top < window.innerHeight && rect.bottom > 0;
        if (alreadyInView) {
          el.classList.add("is-revealed");
        } else {
          io.observe(el);
        }
      });
    }
  }
</script>
