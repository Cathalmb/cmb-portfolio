---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServicesHero from "../components/sections/ServicesHero.astro";
import ServicesIntro from "../components/sections/ServicesIntro.astro";
import ServicesCta from "../components/sections/ServicesCta.astro";
import ServiceBreakdown from "../components/sections/ServiceBreakdown.astro";
import ServicesWork from "../components/sections/ServicesWork.astro";
import ServicesStartProject from "../components/sections/ServicesStartProject.astro";

const title =
  "Services | Brand Strategy, Design & Photography | Cathal Mac an Bheatha";
const description =
  "Creative direction for Irish brands. Strategy, identity, design, and photography under one lead, with monthly retainers from €1,800. In English and Irish.";
---

<BaseLayout title={title} description={description}>
  <ServicesHero />
  <ServicesIntro />
  <ServicesCta />
  <ServiceBreakdown />
  <ServicesWork />
  <ServicesStartProject />
</BaseLayout>

<script>
  // Scroll reveal: fade + rise each [data-reveal] element as it enters view.
  // Hidden state is scoped to `.reveal-ready` (added to <html>) so no-JS shows all.
  const root = document.documentElement;
  const els = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (els.length) {
    root.classList.add("reveal-ready");
    if (reduce || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-revealed"));
    } else {
      const io = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              obs.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
      );
      els.forEach((el) => {
        // Reveal immediately if the element is already on-screen when this
        // runs (fixes inner-page heroes staying at opacity:0 until the user
        // scrolls — IO's initial callback wasn't landing reliably before
        // any scroll event; fixed July 14 2026 across all pages using this
        // script). Only observe elements that still need to come into view.
        const rect = el.getBoundingClientRect();
        const alreadyInView = rect.top < window.innerHeight && rect.bottom > 0;
        if (alreadyInView) {
          el.classList.add("is-revealed");
        } else {
          io.observe(el);
        }
      });
    }
  }
</script>
