---
/**
 * Case study — generic section header. Reused for every named block in
 * both templates: "/ The Challenge", "/ The Solution", "/ What I
 * Delivered", "/ The Brief", "/ On The Ground", "/ Outcomes", and any
 * bespoke "signature section" a project needs (e.g. "/ The Portal",
 * "/ The Website"). The leading slash is a deliberate case-study-only
 * device, distinct from the plain labels used elsewhere on the site
 * ("Services", "Work", "What I build").
 *
 * `paragraphs` is optional — some sections (Three Ireland's "What I
 * Delivered") go straight from heading into a deliverables list with no
 * lead-in copy.
 */
interface Props {
  label: string;
  heading: string;
  paragraphs?: string[];
  /** Paragraph max-width — 896 for wider standfirst-style copy, 664 for narrower blocks. Default 896. */
  proseWidth?: 664 | 896;
}

const { label, heading, paragraphs = [], proseWidth = 896 } = Astro.props;
const widthClass = proseWidth === 664 ? "max-w-[664px]" : "max-w-[896px]";
---

<div>
  <p data-reveal class="text-body-md text-n500">/ {label}</p>
  <h2 data-reveal style="--reveal-delay: 80ms" class="mt-3 max-w-[664px] text-heading-lg text-n900 lg:mt-4 lg:text-display-sm">
    {heading}
  </h2>
  {
    paragraphs.length > 0 && (
      <div class="mt-6 lg:mt-8">
        {paragraphs.map((p, i) => (
          <p data-reveal style={`--reveal-delay: ${120 + i * 40}ms`} class={`text-body-lg text-n500 pb-[1em] last:pb-0 ${widthClass}`}>
            {p}
          </p>
        ))}
      </div>
    )
  }
</div>
