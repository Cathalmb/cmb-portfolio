---
/**
 * About — Client wall. Figma node 73:219. STATIC 4-column grid, 4 rows (16
 * cells). EXACT values: cells 300×211 with 48px gaps (4×300 + 3×48 = 1344),
 * logos width-normalised and centred with generous whitespace. No heading in
 * the frame. 16 distinct logos, row-major, matching the frame cell-for-cell:
 *
 *   Row 1: Three | Conradh na Gaeilge | Abbey Theatre | Gael Linn
 *   Row 2: Foras na Gaeilge | Rí-Rá | RTÉ | TG4
 *   Row 3: Cotone | Tirlán | GOAL | Panda
 *   Row 4: Skingredients | 212 Yachts | Talent Garden | Bia Energy
 *
 * Five marks already existed in the repo and check out against the Figma
 * frame (Conradh, Rí-Rá, Foras na Gaeilge, RTÉ, Skingredients) — reused as-is.
 * The old gael-linn.svg was the full-colour brand mark (not the plain-white
 * wordmark in this frame) and the old tg4.png was black-on-white (not
 * transparent), so both were swapped for "-white" exports. Abbey Theatre, Bia
 * Energy, Talent Garden, Tirlán, 212 Yachts, Panda and Cotone use SVG source
 * files (sharper at the 2x/retina sizes this wall renders at than PNG exports).
 *
 * MOBILE OVERFLOW BUG FIXED (July 15 2026) — logos were blowing out past both
 * screen edges on real phones. Two compounding causes:
 *   1. This project redefines Tailwind's `sm:` breakpoint to 390px (global.css
 *      --breakpoint-sm), i.e. "basically any phone." The grid was built
 *      `grid-cols-2 sm:grid-cols-4` assuming stock Tailwind sm=640px (tablet),
 *      so the 4-col layout was firing on phones instead of the intended
 *      2-col fallback. Bumped the breakpoint to `md:` (768px) so phones stay
 *      2-col and only tablet+ gets 4.
 *   2. Even at 4 columns this would've overflowed: the `<li>` grid cell is a
 *      flex container, and flex children default to `min-width: auto`,
 *      which stops them shrinking below their own content size even when
 *      the parent track is narrower — same underlying quirk noted on the
 *      /creative-partner tier CTA pills. Added `min-w-0 overflow-hidden` to
 *      the `<li>` so the grid track's width is actually enforced.
 *   CORRECTION (same day): first pass swapped the image's fixed
 *   `max-w-[180px]` for `max-w-full`, which fixed mobile but let wide-aspect
 *   logos balloon to fill the full ~300px desktop cell — a real regression,
 *   flagged by Cathal ("logos are much bigger than they originally were").
 *   Now `max-w-[85%] lg:max-w-[180px]`: restores the exact original 180px
 *   desktop cap (same generous-whitespace look as before) from `lg:` (1024px)
 *   up, and uses a cell-proportional 85% cap below that so it never overflows
 *   regardless of how narrow an individual breakpoint's grid track gets.
 *   LESSON: any custom breakpoint renaming (this project's sm/md/lg/xl are
 *   NOT stock Tailwind values) needs re-checking against every existing
 *   `sm:`/`md:`/etc. usage when it's introduced — a component built before
 *   the rename can silently break without any code change of its own.
 */
import Container from "../primitives/Container.astro";

const cells = [
  { src: "/images/clients/three-ireland.png", name: "Three" },
  { src: "/images/clients/conradh-na-gaeilge.png", name: "Conradh na Gaeilge" },
  { src: "/images/clients/abbey-theatre-logo.svg", name: "Abbey Theatre" },
  { src: "/images/clients/gael-linn-white.png", name: "Gael Linn" },
  { src: "/images/clients/foras-na-gaeilge.png", name: "Foras na Gaeilge" },
  { src: "/images/clients/ri-ra.png", name: "Rí-Rá" },
  { src: "/images/clients/rte.png", name: "RTÉ" },
  { src: "/images/clients/tg4-white.png", name: "TG4" },
  { src: "/images/clients/cotone-logo.svg", name: "Cotone" },
  { src: "/images/clients/tirlan-logo.svg", name: "Tirlán" },
  { src: "/images/clients/goal.png", name: "GOAL" },
  { src: "/images/clients/panda-logo.svg", name: "Panda" },
  { src: "/images/clients/skingredients-logo.svg", name: "Skingredients" },
  { src: "/images/clients/212-yachts.svg", name: "212 Yachts" },
  { src: "/images/clients/talent-garden-logo.svg", name: "Talent Garden" },
  { src: "/images/clients/bia-energy-logo.svg", name: "Bia Energy" },
];
---

<section class="bg-n900">
  <Container size="large">
    <div class="pb-24 lg:pb-[192px]">
      <ul
        data-reveal
        class="grid grid-cols-2 gap-6 md:grid-cols-4"
      >
        {
          cells.map((c) => (
            <li class="flex min-w-0 min-h-[140px] items-center justify-center overflow-hidden lg:min-h-[211px]">
              <img
                src={c.src}
                alt={c.name}
                loading="lazy"
                class="max-h-[64px] w-auto max-w-[85%] object-contain lg:max-h-[80px] lg:max-w-[180px]"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
