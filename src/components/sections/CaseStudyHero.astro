---
/**
 * Case study — Hero. Shared by both the brand/design template and the
 * photography/video template (see case-study-structure.md).
 *
 * NOTE: there's no Figma frame for individual case-study pages yet — this
 * is built directly off the existing design system (same H1 scale as
 * WorkHero/ServicesHero/AboutHero, same rounded-24 card language as the
 * /work grid) rather than a specific frame. Flag to Cathal: happy to
 * re-tune once/if a frame exists.
 *
 * Fields map to the legacy case-study frontmatter (title, client, scope,
 * intro, heroImage) so existing copy ports over directly.
 */
import Container from "../primitives/Container.astro";

interface Props {
  title: string;
  client: string;
  scope: string;
  intro: string;
  heroImage: string;
}

const { title, client, scope, intro, heroImage } = Astro.props;
---

<section class="bg-n100">
  <Container size="large">
    <div class="pt-12 pb-6 lg:pb-8">
      <p data-reveal class="text-body-md text-n500">Case Study</p>
      <h1 data-reveal style="--reveal-delay: 80ms" class="mt-1 max-w-[1004px] text-heading-xl text-n900 lg:text-display-lg">
        {title}
      </h1>
      <p data-reveal style="--reveal-delay: 120ms" class="mt-3 text-body-md text-n500 lg:mt-4">
        {client} <span class="mx-1 text-n200">·</span> {scope}
      </p>
      <p data-reveal style="--reveal-delay: 160ms" class="mt-6 max-w-[896px] text-heading-sm text-n900 lg:mt-8 lg:text-heading-md">
        {intro}
      </p>
    </div>

    <div data-reveal style="--reveal-delay: 200ms" class="aspect-[342/499] overflow-hidden rounded-[24px] lg:aspect-[16/9]">
      <img src={heroImage} alt="" loading="eager" class="h-full w-full object-cover" />
    </div>
  </Container>
</section>
