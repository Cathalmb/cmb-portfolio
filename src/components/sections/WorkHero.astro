---
/**
 * Work — Hero. Figma node 109:305 ("desktop-work"), headline at top:176,
 * width 1004, display-lg (95/96, -1.9px) with an ochre full stop. Same
 * hero→divider gap (128) as the Services hero — mirrors ServicesHero.astro.
 */
import Container from "../primitives/Container.astro";
---

<section class="bg-n100">
  <Container size="large">
    <div class="pt-12 pb-16 lg:pb-[128px]">
      <h1 data-reveal class="max-w-[1004px] text-heading-xl text-n900 lg:text-display-lg">
        Work built for the brand, not the portfolio<span class="text-ochre">.</span>
      </h1>
    </div>
  </Container>
</section>
