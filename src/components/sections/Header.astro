---
/**
 * Header — global site navigation. Built from Figma node 1:3 (Website file).
 *
 * Desktop (lg+): full-width bar, wordmark left, centred white nav pill,
 *   black "Work with me" CTA right.
 * Mobile (< lg): white pill with short wordmark + black hamburger that
 *   toggles a stacked menu.
 *
 * Reminder: --spacing is 8px, so h-7 = 56px, h-6 = 48px, px-3 = 24px,
 * py-2 = 16px, gap-1 = 8px. Do not read these as the Tailwind defaults.
 */
import Container from "../primitives/Container.astro";

interface Props {
  size?: "site" | "large";
  /**
   * "light" (default) = light bar + dark wordmark + dark CTA (all existing pages).
   * "dark" = transparent bar over a dark page + light wordmark + inverted (light)
   * CTA. Used by /about, which is a full dark-page design (Figma 68:109). The
   * white desktop nav pill and mobile white pill are unchanged in both themes.
   */
  theme?: "light" | "dark";
}
const { size = "large", theme = "light" } = Astro.props;
const dark = theme === "dark";

const navItems = [
  { label: "Services", href: "/services" },
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
  // Gaeilge temporarily removed from nav — page not live yet.
];
const cta = { label: "Work with me", href: "/contact" };

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  !href.includes("#") &&
  (pathname === href || (href !== "/" && pathname.startsWith(href + "/")));
---

<header
  id="site-header"
  class:list={[
    "sticky top-0 z-50 transition-transform duration-300 will-change-transform",
    dark ? "lg:bg-transparent" : "lg:bg-n100",
  ]}
>
  <Container size={size}>
    <div class="py-3">
      <!-- ============================ DESKTOP ============================ -->
      <div class="relative hidden h-7 items-center justify-between lg:flex">
        <!-- Wordmark (light variant on the dark theme) -->
        <a href="/" class="flex items-center" aria-label="Cathal Mac an Bheatha — home">
          <img
            src={dark ? "/images/cmb-wordmark-light.svg" : "/images/cmb-wordmark.svg"}
            alt=""
            class="h-auto w-[232px]"
          />
        </a>

        <!-- Centred nav pill. The ochre-tint indicator is a single element that
             JS slides + resizes to the hovered/focused item (see script below). -->
        <nav aria-label="Primary" class="absolute left-1/2 -translate-x-1/2">
          <ul id="nav-pill" class="relative flex items-center gap-1 rounded-full bg-white p-[2px]">
            <span
              id="nav-indicator"
              aria-hidden="true"
              class="pointer-events-none absolute left-0 top-0 rounded-full bg-ochre-tint opacity-0 will-change-transform"
            ></span>
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    data-nav-item
                    data-active={isActive(item.href) ? "true" : "false"}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class="relative z-10 flex items-center rounded-full px-3 py-2 text-body-md font-medium text-n900"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- CTA (inverted on the dark theme: light pill, dark label) -->
        <a
          href={cta.href}
          class:list={[
            "flex items-center rounded-full px-3 py-2 text-body-md font-medium transition-colors",
            dark
              ? "bg-n100 text-n900 hover:bg-white"
              : "bg-n900 text-n100 hover:bg-n800",
          ]}
        >
          {cta.label}
        </a>
      </div>

      <!-- ============================ MOBILE ============================= -->
      <div class="relative lg:hidden">
        <div
          id="mobile-nav-pill"
          class="flex h-6 items-center justify-between rounded-full bg-white pl-2 pr-[2px]"
        >
          <a href="/" class="flex items-center" aria-label="Cathal Mac an Bheatha — home">
            <img src="/images/cmb-wordmark-short.svg" alt="" class="h-auto w-[88px]" />
          </a>
          <button
            type="button"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
            class="flex h-[44px] w-[44px] items-center justify-center rounded-full bg-n900 text-n100"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
              data-icon="open"
            >
              <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
              data-icon="close"
              class="hidden"
            >
              <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </button>
        </div>

        <!-- Toggled menu panel. Open state wasn't in the Figma frames — this is
             my interpretation in the same visual language; easy to restyle. -->
        <div id="mobile-menu" hidden class="mt-2 rounded-md bg-white p-2">
          <ul class="flex flex-col">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    class:list={[
                      "flex items-center rounded-full px-3 py-2 text-body-md font-medium text-n900",
                      isActive(item.href) ? "bg-ochre-tint" : "hover:bg-ochre-tint",
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href={cta.href}
            class="mt-2 flex items-center justify-center rounded-full bg-n900 px-3 py-2 text-body-md font-medium text-n100"
          >
            {cta.label}
          </a>
        </div>
      </div>
    </div>
  </Container>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const iconOpen = toggle.querySelector('[data-icon="open"]');
    const iconClose = toggle.querySelector('[data-icon="close"]');
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true")
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }

  // ---- Sliding hover indicator (desktop nav) -----------------------------
  const pill = document.getElementById("nav-pill");
  const indicator = document.getElementById("nav-indicator");
  if (pill && indicator) {
    const items = Array.from(
      pill.querySelectorAll<HTMLElement>("[data-nav-item]")
    );
    const activeItem = items.find((i) => i.dataset.active === "true") ?? null;

    const moveTo = (el: HTMLElement, animate = true) => {
      if (!animate) indicator.style.transition = "none";
      indicator.style.width = `${el.offsetWidth}px`;
      indicator.style.height = `${el.offsetHeight}px`;
      indicator.style.transform = `translate(${el.offsetLeft}px, ${el.offsetTop}px)`;
      indicator.style.opacity = "1";
      if (!animate) {
        void indicator.offsetWidth; // force reflow, then restore transition
        indicator.style.transition = "";
      }
    };

    const reset = () => {
      if (activeItem) moveTo(activeItem);
      else indicator.style.opacity = "0";
    };

    items.forEach((item) => {
      item.addEventListener("mouseenter", () => moveTo(item));
      item.addEventListener("focus", () => moveTo(item));
    });
    pill.addEventListener("mouseleave", reset);
    pill.addEventListener("focusout", (e) => {
      if (!pill.contains((e as FocusEvent).relatedTarget as Node)) reset();
    });

    // Rest on the active item (no animation) once layout — and fonts — are ready.
    const settle = () => {
      if (activeItem) moveTo(activeItem, false);
    };
    requestAnimationFrame(settle);
    document.fonts?.ready.then(settle);
    window.addEventListener("resize", () => {
      if (activeItem && indicator.style.opacity === "1") moveTo(activeItem, false);
    });
  }

  // ---- Scroll behaviour --------------------------------------------------
  // Mobile: subtle shadow on the pill once scrolled.
  // Desktop: hide the bar on scroll-down, reveal on scroll-up.
  const header = document.getElementById("site-header");
  if (header) {
    let lastY = window.scrollY;
    let ticking = false;
    const apply = () => {
      const y = window.scrollY;
      header.classList.toggle("is-scrolled", y > 4);
      if (y > lastY && y > 96) {
        header.classList.add("is-hidden");
      } else if (y < lastY) {
        header.classList.remove("is-hidden");
      }
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          window.requestAnimationFrame(apply);
          ticking = true;
        }
      },
      { passive: true }
    );
  }
</script>

<style>
  /* Slide + resize easing for the nav indicator. */
  #nav-indicator {
    transition:
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    #nav-indicator {
      transition: opacity 0.2s ease;
    }
  }

  /* Desktop: hide the header on scroll-down, reveal on scroll-up. */
  @media (min-width: 1024px) {
    #site-header.is-hidden {
      transform: translateY(-100%);
    }
  }

  /* Mobile: smallest lift on the nav pill once scrolled off the top. */
  #mobile-nav-pill {
    transition: box-shadow 0.2s ease;
  }
  #site-header.is-scrolled #mobile-nav-pill {
    box-shadow: 0 2px 6px rgba(10, 10, 10, 0.07);
  }

  @media (prefers-reduced-motion: reduce) {
    #site-header {
      transition: none;
    }
  }
</style>
