---
/**
 * Services — discovery-call CTA. Figma node 74:218. Full-width card (1344×392,
 * radius 24, subtle n200 border) with a centred heading-xl (49/56) and a black
 * pill button below it (gap 32). Content is vertically centred in the card.
 *
 * NOTE: the frame uses a textured background image (imgRectangle1). It can't be
 * pulled into the repo from here, so this uses a warm gradient placeholder —
 * export the real texture from Figma to /public/images and swap `background`.
 *
 * Spacing: intro→card 96 (intro pb), card→statement 160 (this section pb-20).
 */
import Container from "../primitives/Container.astro";
---

<section class="bg-n100">
  <Container size="large">
    <div class="pb-16 lg:pb-[160px]">
      <div
        data-reveal
        class="cta-card relative flex h-[320px] flex-col items-center justify-center overflow-hidden rounded-[24px] border border-n200 px-6 text-center lg:h-[392px]"
      >
        <h2 class="max-w-[880px] text-heading-md text-n900 lg:text-heading-xl">
          Book a discovery call. Let&rsquo;s talk!
        </h2>
        <a
          href="/contact"
          class="mt-4 inline-flex h-[52px] items-center justify-center gap-1 rounded-full bg-n900 px-4 text-body-sm font-medium text-n100 transition-colors hover:bg-n800"
        >
          Let&rsquo;s talk
          <svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true" class="shrink-0">
            <path d="M0 4h12M9.5 1 13 4l-3.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  /* Placeholder texture — swap for the exported Figma asset. */
  .cta-card {
    background:
      radial-gradient(130% 130% at 28% 18%, #f6eadc 0%, rgba(246, 234, 220, 0) 55%),
      linear-gradient(135deg, #efece7 0%, #e6e6e6 60%, #ddd9d4 100%);
  }
</style>
