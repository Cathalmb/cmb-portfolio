---
/**
 * About — Statement. Figma node 73:100. Dark section. display-sm (61/64,
 * -0.02em) n100 with an ochre full stop, width 996, at the left gutter.
 * Sits 192px below the gallery (this section's top padding).
 */
import Container from "../primitives/Container.astro";
---

<section class="bg-n900">
  <Container size="large">
    <div class="pt-16 pb-8 lg:pt-[192px]">
      <h2
        data-reveal
        class="max-w-[996px] text-heading-lg text-n100 lg:text-display-sm"
      >
        I believe most creative problems are solved before anything gets
        designed<span class="text-ochre">.</span>
      </h2>
    </div>
  </Container>
</section>
