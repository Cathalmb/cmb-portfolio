---
/**
 * Hero — homepage intro. Built from Figma 29:61 (desktop) + 22:287 (mobile).
 *
 * The two breakpoints reorder the same pieces (via flex `order`), so the source
 * stays in a sensible reading order:
 *   Desktop:  headline → subhead → buttons → meta
 *   Mobile:   headline → buttons → meta → subhead (subhead gains an ochre square)
 *
 * Meta text differs per breakpoint (both 13px / body-sm — the 8px micro size
 * was dropped July 2026 after design review: illegible on device):
 *   Desktop: "Gaeilge agus Fáilte"  ·  "Dublin - HH:MMAM" (live clock)
 *   Mobile:  "What I do"            ·  "Gaeilge agus Fáilte"
 *
 * Reminder: --spacing is 8px → pt-12 = 96, mt-6 = 48, mt-4 = 32, mt-3 = 24,
 * pt-1 = 8, gap-1 = 8, h-1.5 = 12.
 */
import Container from "../primitives/Container.astro";

const subhead =
  "Brand strategy, design, and photography. From the first conversation to the last deliverable. One creative director, who can lead a project end-to-end go hiomlán trí mheán na Gaeilge.";
---

<section>
  <Container size="large">
    <div class="flex flex-col pt-6 pb-2 lg:pt-12">
      <!-- Headline -->
      <h1 class="order-1 max-w-[880px] text-heading-xl text-n900 lg:text-display-lg">
        I help Irish brands get their creative right<span class="text-ochre">.</span>
      </h1>

      <!-- Subhead (bottom on mobile, under headline on desktop) -->
      <p class="order-4 mt-3 mb-4 max-w-[648px] text-body-lg text-n500 lg:order-2 lg:mb-0">
        <span
          aria-hidden="true"
          class="mr-2 inline-block h-1.5 w-1.5 bg-ochre align-[0.05em] lg:hidden"
        ></span>{subhead}
      </p>

      <!-- Buttons -->
      <div class="order-2 mt-6 flex flex-col gap-1 lg:order-3 lg:mt-4 lg:flex-row">
        <a
          href="/work"
          class="inline-flex w-full items-center justify-center rounded-full bg-n900 px-3 py-2 text-body-md font-medium text-n100 transition-colors hover:bg-n800 lg:w-auto"
        >
          See the work
        </a>
        <a
          href="/contact"
          class="inline-flex w-full items-center justify-center gap-1 rounded-full border border-n200 px-4 py-2 text-body-md font-medium text-n900 transition-colors hover:border-n900 lg:w-auto"
        >
          Let's talk
          <svg
            width="14"
            height="8"
            viewBox="0 0 14 8"
            fill="none"
            aria-hidden="true"
            class="shrink-0"
          >
            <path
              d="M0 4h12M9.5 1 13 4l-3.5 3"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>

      <!-- Meta -->
      <div class="order-3 mt-6 border-t border-n200 pt-1 lg:order-4 lg:mt-12 lg:pt-2">
        <div class="flex items-center justify-between text-body-sm text-n500">
          <span>
            <span class="lg:hidden">What I do</span>
            <span class="hidden lg:inline">Gaeilge agus Fáilte</span>
          </span>
          <span>
            <span class="lg:hidden">Gaeilge agus Fáilte</span>
            <span class="hidden lg:inline" id="hero-clock">Dublin -&nbsp;</span>
          </span>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  // Live Dublin time for the desktop meta, e.g. "Dublin - 08:53AM".
  const clock = document.getElementById("hero-clock");
  if (clock) {
    const render = () => {
      const t = new Date().toLocaleTimeString("en-US", {
        timeZone: "Europe/Dublin",
        hour: "2-digit",
        minute: "2-digit",
        hour12: true,
      });
      clock.textContent = "Dublin - " + t.replace(" ", "");
    };
    render();
    setInterval(render, 15000);
  }
</script>
